# =============================================================================
# Persona Distillation · 环境变量模板
# =============================================================================
# 复制此文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会被提交。
#
#   cp .env.example .env
#   ${EDITOR:-vi} .env
#   set -a; source .env; set +a   # 或用 python-dotenv 自动加载
#
# 框架默认读 os.environ[name]，所以也可直接：
#   export MINIMAX_API_KEY=sk-...
# =============================================================================

# ---- LLM 主对话（distill / chat） ----
# OpenAI 兼容协议；base_url 需含 /v1 后缀
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=sk-REPLACE_ME_WITH_YOUR_KEY
# 主模型：provider:model 字符串；provider=minimax 走 OpenAI 兼容端点
MINIMAX_MODEL=minimax:MiniMax-M3
# 默认人格 ID（CLI 不指定时使用）
MINIMAX_PERSONA_ID=arakawa_sensei

# ---- Intake 子包：嵌入 + 重排序 ----
# 同一站点的同 key，模型名不同
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-base
# 若希望强制离线（用 HashEmbeddings 兜底），设为 1
OFFLINE=0

# ---- 可选：日志级别 ----
# LOG_LEVEL=INFO          # DEBUG / INFO / WARNING / ERROR
